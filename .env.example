# Expo client: host reachable by the device running the app.
# Android emulator: http://10.0.2.2:8080
# Physical phone: http://YOUR_COMPUTER_LAN_IP:8080
EXPO_PUBLIC_API_URL=

# Backend local development only. Never commit real production credentials.
DB_URL=jdbc:mysql://localhost:3306/campusloop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=campusloop
DB_PASSWORD=campusloop_local_only
MYSQL_ROOT_PASSWORD=root_local_only

# Razorpay credentials belong ONLY in the backend environment, not the Expo client.
# Use test keys while developing. Replace placeholders locally; never commit actual keys.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Expo client: use a host reachable by the device running the app.
# Android emulator: http://10.0.2.2:8080
# Physical phone: http://YOUR_COMPUTER_LAN_IP:8080
EXPO_PUBLIC_API_URL=

# Backend local development only. Never commit real production credentials.
DB_URL=jdbc:mysql://localhost:3306/campusloop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=campusloop
DB_PASSWORD=replace-with-local-secret
MYSQL_ROOT_PASSWORD=replace-with-local-root-secret

# Configure only on the server after selecting a payment provider.
PAYMENT_PROVIDER=disabled
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
